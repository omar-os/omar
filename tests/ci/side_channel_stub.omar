// Model-free regression: both invocations reach the stub through its queue.
team SideChannel[worker : Stub]
{
    input request : string
    action next : string
    output result : string

    task worker(request) -> next
    "Answer the first invocation."

    task worker(next) -> result
    "Answer the second invocation."
}

main {
    run = SideChannel()
}
