// OMAR topology integration source.
// Exercises an action feeding its own reaction across microsteps. This is the
// recurrence pattern available before dedicated startup/bounds syntax lands.
team Recurrence[counter : Codex]
{
    input start : int
    output result : int
    action next : int

    task counter(start, next) -> (next | result)
    "
        Exactly one of these triggers is present:
        start=$(start)
        next=$(next)
        Treat the present value as the current integer. If it is less than 3,
        set `next` to current + 1. Otherwise set `result` to the current value.
        Never set both effects. This should terminate with result 3.
    "
}

// Smoke test: passes once the program has produced what it owes, and
// fails if the deadline comes first. A failed assert fails the run.
team Smoke
{
    input result : int
    state got_result : bool = false
    timer deadline(10min, 0)

    reaction(result) -> {=
        if result.is_some() { self.got_result = true; }
        if self.got_result { request_stop(); }
    =}
    reaction(deadline) -> {= request_stop(); =}
    reaction(shutdown) -> {=
        assert!(self.got_result, "no rec.result by the deadline");
    =}
}

main {
    rec = Recurrence()

    smoke = Smoke()
    rec.result -> smoke.result
}
