// OMAR topology integration source.
// Exercises concurrent fan-out, a tag barrier, fan-in, and a multi-trigger
// reaction receiving both values in one invocation.
team FanOutFanIn[dispatcher : Codex,
                 analyst : Codex,
                 critic : Codex,
                 aggregator : Codex]
{
    input request : string
    output answer : string
    action brief : string
    action analysis : string
    action criticism : string

    task dispatcher(request) -> brief
    "
        Turn this request into a one-sentence brief and set `brief`:
        $(request)
    "

    task analyst(brief) -> analysis
    "
        Produce a concise constructive analysis of this brief and set `analysis`:
        $(brief)
    "

    task critic(brief) -> criticism
    "
        Identify the most important risk in this brief and set `criticism`:
        $(brief)
    "

    task aggregator(analysis, criticism) -> answer
    "
        The tag barrier delivers both parallel results together.
        Analysis: $(analysis)
        Criticism: $(criticism)
        Combine them into a concise final answer and set `answer`.
    "
}

// Smoke test: passes once the program has produced what it owes, and
// fails if the deadline comes first. A failed assert fails the run.
team Smoke
{
    input answer : string
    state got_answer : bool = false
    timer deadline(10min, 0)

    reaction(answer) -> {=
        if answer.is_some() { self.got_answer = true; }
        if self.got_answer { request_stop(); }
    =}
    reaction(deadline) -> {= request_stop(); =}
    reaction(shutdown) -> {=
        assert!(self.got_answer, "no fan.answer by the deadline");
    =}
}

main {
    fan = FanOutFanIn()

    smoke = Smoke()
    fan.answer -> smoke.answer
}
