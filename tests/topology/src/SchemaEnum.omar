// OMAR topology integration source.
// Two types imported from JSON Schema files beside this source, one with a
// title and description and one bare. A prompt writes both enum ports, and a
// code reaction reads them: a body may read an enum port, since what arrives
// was checked against the enum when it was written, though it may not write
// one. The stub answers each effect with the first value its type admits, so
// the route it reports is fixed by the schema files, not by the prompt.
type Decision from "./schemas/decision.json"
type Priority from "./schemas/priority.json"

team Review[reviewer : Stub]
{
    input request : string
    output decision : Decision
    output priority : Priority

    task reviewer(request) -> decision, priority
    "
        Review this request: $(request)
        Write a decision and a priority. Each port admits only the values its
        type lists; a write outside them is rejected and can be corrected.
    "
}

team Dispatch
{
    input decision : Decision
    input priority : Priority
    output route : string

    reaction(decision, priority) -> route {=
        route = Some(format!(
            "{}:{}",
            decision.unwrap_or_default(),
            priority.unwrap_or_default()
        ));
    =}
}

// Smoke test: passes once the program has produced what it owes, and
// fails if the deadline comes first. A failed assert fails the run.
team Smoke
{
    input decision : Decision
    input priority : Priority
    input route : string
    state got_decision : bool = false
    state got_priority : bool = false
    state got_route : bool = false
    timer deadline(10min, 0)

    reaction(decision, priority, route) -> {=
        if decision.is_some() { self.got_decision = true; }
        if priority.is_some() { self.got_priority = true; }
        if route.is_some() { self.got_route = true; }
        if self.got_decision && self.got_priority && self.got_route { request_stop(); }
    =}
    reaction(deadline) -> {= request_stop(); =}
    reaction(shutdown) -> {=
        assert!(self.got_decision, "no review.decision by the deadline");
        assert!(self.got_priority, "no review.priority by the deadline");
        assert!(self.got_route, "no dispatch.route by the deadline");
    =}
}

main {
    review = Review()
    dispatch = Dispatch()

    review.decision -> dispatch.decision
    review.priority -> dispatch.priority

    smoke = Smoke()
    review.decision -> smoke.decision
    review.priority -> smoke.priority
    dispatch.route -> smoke.route
}
