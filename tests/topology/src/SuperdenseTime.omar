// Exercises superdense tags, fixed action delay, and delayed port routing.
team SuperdenseTime[producer : Codex,
                    fixed_consumer : Codex,
                    connected_consumer : Codex]
{
    input start : int
    output fixed_result : int
    output connected_result : int

    action immediate : int
    action fixed(delay=2ns) : int
    action connected(delay=1ns) : int

    // `immediate` arrives at (0, 1). The connection delay of 3 and connected's
    // fixed delay of 1 are additive, so `connected` arrives at (4, 0).
    immediate -> connected after 3ns

    task producer(start) -> immediate, fixed
    "
        Set both `immediate` and `fixed` to the integer $(start).
    "

    // `fixed` is scheduled directly by the producer and arrives at (2, 0).
    task fixed_consumer(fixed) -> fixed_result
    "
        Copy $(fixed) to `fixed_result`.
    "

    task connected_consumer(connected) -> connected_result
    "
        Copy $(connected) to `connected_result`.
    "
}

// Smoke test: passes once the program has produced what it owes, and
// fails if the deadline comes first. A failed assert fails the run.
team Smoke
{
    input fixed_result : int
    input connected_result : int
    state got_fixed_result : bool = false
    state got_connected_result : bool = false
    timer deadline(10min, 0)

    reaction(fixed_result, connected_result) -> {=
        if fixed_result.is_some() { self.got_fixed_result = true; }
        if connected_result.is_some() { self.got_connected_result = true; }
        if self.got_fixed_result && self.got_connected_result { request_stop(); }
    =}
    reaction(deadline) -> {= request_stop(); =}
    reaction(shutdown) -> {=
        assert!(self.got_fixed_result, "no time.fixed_result by the deadline");
        assert!(self.got_connected_result, "no time.connected_result by the deadline");
    =}
}

main {
    time = SuperdenseTime()

    smoke = Smoke()
    time.fixed_result -> smoke.fixed_result
    time.connected_result -> smoke.connected_result
}
