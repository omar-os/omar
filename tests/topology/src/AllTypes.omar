// OMAR topology integration source.
/* Exercises every documented port type, nested generic type parsing,
   /* including nested block comments, */ multiple required effects, and
   interpolation of structured trigger values. */
team AllTypes[codec : Codex]
{
    input bool_in : bool
    input int_in : int
    input float_in : float
    input string_in : string
    input path_in : path
    input bytes_in : bytes
    input list_in : list<int>
    input option_in : option<string>
    input nested_in : list<option<int>>

    output bool_out : bool
    output int_out : int
    output float_out : float
    output string_out : string
    output path_out : path
    output bytes_out : bytes
    output list_out : list<int>
    output option_out : option<string>
    output nested_out : list<option<int>>

    task codec(bool_in, int_in, float_in, string_in, path_in, bytes_in, list_in, option_in, nested_in)
        -> bool_out, int_out, float_out, string_out, path_out, bytes_out, list_out, option_out, nested_out
    "
        Copy each present input to the output with the matching suffix.
        bool=$(bool_in)
        int=$(int_in)
        float=$(float_in)
        string=$(string_in)
        path=$(path_in)
        bytes=$(bytes_in)
        list=$(list_in)
        option=$(option_in)
        nested=$(nested_in)
        Prompt strings preserve escaped quotes like \"this\" and backslashes like \\.
        All nine external inputs arrive at one tag, so set all nine outputs.
    "
}

// Smoke test: passes once the program has produced what it owes, and
// fails if the deadline comes first. A failed assert fails the run.
// A body binds scalars only. list_out, option_out and nested_out are
// written by the same invocation under the same mandatory contract, so
// they arrive whenever these do.
team Smoke
{
    input bool_out : bool
    input int_out : int
    input float_out : float
    input string_out : string
    input path_out : path
    input bytes_out : bytes
    state got_bool_out : bool = false
    state got_int_out : bool = false
    state got_float_out : bool = false
    state got_string_out : bool = false
    state got_path_out : bool = false
    state got_bytes_out : bool = false
    timer deadline(10min, 0)

    reaction(bool_out, int_out, float_out, string_out, path_out, bytes_out) -> {=
        if bool_out.is_some() { self.got_bool_out = true; }
        if int_out.is_some() { self.got_int_out = true; }
        if float_out.is_some() { self.got_float_out = true; }
        if string_out.is_some() { self.got_string_out = true; }
        if path_out.is_some() { self.got_path_out = true; }
        if bytes_out.is_some() { self.got_bytes_out = true; }
        if self.got_bool_out && self.got_int_out && self.got_float_out && self.got_string_out && self.got_path_out && self.got_bytes_out { request_stop(); }
    =}
    reaction(deadline) -> {= request_stop(); =}
    reaction(shutdown) -> {=
        assert!(self.got_bool_out, "no types.bool_out by the deadline");
        assert!(self.got_int_out, "no types.int_out by the deadline");
        assert!(self.got_float_out, "no types.float_out by the deadline");
        assert!(self.got_string_out, "no types.string_out by the deadline");
        assert!(self.got_path_out, "no types.path_out by the deadline");
        assert!(self.got_bytes_out, "no types.bytes_out by the deadline");
    =}
}

main {
    types = AllTypes()

    smoke = Smoke()
    types.bool_out -> smoke.bool_out
    types.int_out -> smoke.int_out
    types.float_out -> smoke.float_out
    types.string_out -> smoke.string_out
    types.path_out -> smoke.path_out
    types.bytes_out -> smoke.bytes_out
}
