// OMAR topology integration source.
// Exercises same-agent serialization even when reactions write disjoint ports,
// followed by fan-in where both actions arrive at the same tag.
team SameAgentSerial[worker : Codex,
                     collector : Codex]
{
    input request : string
    output result : string
    action left : string
    action right : string

    task worker(request) -> left
    "
        Set `left` to `left: $(request)`.
    "

    task worker(request) -> right
    "
        Set `right` to `right: $(request)`. This invocation must run after the
        preceding invocation because both reactions use the same agent.
    "

    task collector(left, right) -> result
    "
        Both serialized effects commit at the same tag boundary.
        left=$(left)
        right=$(right)
        Combine them and set `result`.
    "
}

// Smoke test: passes once the program has produced what it owes, and
// fails if the deadline comes first. A failed assert fails the run.
team Smoke
{
    input result : string
    state got_result : bool = false
    timer deadline(10min, 0)

    reaction(result) -> {=
        if result.is_some() { self.got_result = true; }
        if self.got_result { request_stop(); }
    =}
    reaction(deadline) -> {= request_stop(); =}
    reaction(shutdown) -> {=
        assert!(self.got_result, "no serial.result by the deadline");
    =}
}

main {
    serial = SameAgentSerial()

    smoke = Smoke()
    serial.result -> smoke.result
}
